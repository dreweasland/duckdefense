{
  "name": "duckdefense",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "dev:api": "npm run build && wrangler d1 migrations apply duckdefense --local && wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply duckdefense --remote"
  },
  "dependencies": {
    "obscenity": "^0.4.6",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
