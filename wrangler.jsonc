{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duckdefense",
  "compatibility_date": "2026-09-28",

  // The Worker handles the leaderboard API; everything else is the game's static files.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Single-page game: unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // Send API requests to the Worker before looking for a static file.
    "run_worker_first": ["/api/*"]
  },

  // The leaderboard database. Migrations live in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duckdefense",
      "database_id": "22c38714-fd92-48c6-be0f-43fcc05dd7d8",
      "migrations_dir": "migrations"
    }
  ],

  // Custom domain (zone must be on this Cloudflare account). www is the main address.
  // The bare duckdefense.com is NOT listed: a Cloudflare redirect rule sends it to www, and
  // that rule needs its own DNS record, which Cloudflare won't let a Worker domain replace
  // (deploys used to end with "Hostname 'duckdefense.com' already has externally managed
  // DNS records" after uploading the game).
  "routes": [{ "pattern": "www.duckdefense.com", "custom_domain": true }]
}
